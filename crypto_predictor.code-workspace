{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.formatting.provider": "black",
    "editor.formatOnSave": true,
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      ".venv": true
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run Pipeline (Scheduler)",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/run_pipeline.py",
        "console": "integratedTerminal",
        "envFile": "${workspaceFolder}/.env"
      },
      {
        "name": "Run API Server",
        "type": "python",
        "request": "launch",
        "module": "uvicorn",
        "args": ["api.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
        "console": "integratedTerminal",
        "envFile": "${workspaceFolder}/.env"
      },
      {
        "name": "Train Models (Bitcoin)",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/ml_engine/train_model.py",
        "args": ["bitcoin"],
        "console": "integratedTerminal",
        "envFile": "${workspaceFolder}/.env"
      }
    ]
  }
}
